{
    "$comment": "Snapshot of the STABLE fields of pattern contract 1 (docs/pattern-contract.md). Changing this file changes the contract: bump contract instead.",
    "contract": 1,
    "types": {
        "plan": {
            "type": "object",
            "required": ["contract", "type", "feature", "units"],
            "properties": {
                "contract": { "const": 1 },
                "type": { "const": "plan" },
                "feature": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } },
                "units": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["leaf", "recipe", "make", "role"],
                        "properties": {
                            "leaf": { "type": "string" },
                            "recipe": { "type": "string" },
                            "make": { "type": ["string", "null"] },
                            "role": { "type": "string" }
                        }
                    }
                }
            }
        },
        "question": {
            "type": "object",
            "required": ["contract", "type", "id", "question", "options"],
            "properties": {
                "contract": { "const": 1 },
                "type": { "const": "question" },
                "id": { "type": "string" },
                "question": { "type": "string" },
                "options": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                        "type": "object",
                        "required": ["answer", "next"],
                        "properties": { "answer": { "type": "string" }, "next": { "type": "string" } }
                    }
                }
            }
        },
        "leaf": {
            "type": "object",
            "required": ["contract", "type", "id", "recipe", "status", "make", "recipe_make"],
            "properties": {
                "contract": { "const": 1 },
                "type": { "const": "leaf" },
                "id": { "type": "string" },
                "recipe": { "type": "string" },
                "status": { "enum": ["ready", "draft", "gap", "byo"] },
                "make": { "type": ["string", "null"] },
                "recipe_make": { "type": ["string", "null"] }
            }
        },
        "error": {
            "type": "object",
            "required": ["contract", "type", "error"],
            "properties": {
                "contract": { "const": 1 },
                "type": { "const": "error" },
                "error": { "type": "string" }
            }
        }
    }
}
