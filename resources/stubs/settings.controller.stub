namespace {{ namespace }}\Http\Controllers\Settings;

use {{ namespace }}\Actions\Update{{ name }}Settings;
use {{ namespace }}\Http\Requests\Update{{ name }}SettingsRequest;
use Illuminate\Http\RedirectResponse;
use Inertia\Inertia;
use Inertia\Response;
use Tey\Kit\Features\Core\Concerns\Toastable;

final class {{ name }}Controller
{
    use Toastable;

    public function edit(): Response
    {
        return Inertia::render('settings/{{ name }}/Page');
    }

    public function update(Update{{ name }}SettingsRequest $request, Update{{ name }}Settings $update): RedirectResponse
    {
        $update->handle($request->validated());

        $this->toast('Settings saved.')->from('save');

        return to_route('settings.{{ slug }}.edit');
    }
}
