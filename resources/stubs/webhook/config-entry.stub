        // standards-pattern: {{ leaf }}
        [
            'name' => '{{ slug }}',
            'signing_secret' => env('{{ env_prefix }}_WEBHOOK_SECRET', ''),
            'signature_header_name' => '{{ signature_header }}',
            'signature_validator' => {{ namespace }}\Webhooks\{{ name }}\{{ name }}SignatureValidator::class,
            'webhook_profile' => {{ namespace }}\Webhooks\{{ name }}\{{ name }}WebhookProfile::class,
            'webhook_model' => {{ namespace }}\Webhooks\WebhookCall::class,
            'store_headers' => ['{{ signature_header }}', '{{ timestamp_header }}'],
            'store_attachments' => false,
            'process_webhook_job' => {{ namespace }}\Webhooks\{{ name }}\Process{{ name }}Webhook::class,
        ],
