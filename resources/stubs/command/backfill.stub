<?php

// standards-pattern: {{ leaf }}

namespace {{ namespace }}\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;
use Tey\Standards\Operator\Operator;
use Tey\Standards\Operator\OperatorRun;

/**
 * Backfills {{ table }}.{{ column }} for rows that have none. A dry run unless --apply; refused in production unless allow-listed or --force with the
 * name typed back; one run at a time; a re-run skips rows already done. Edit TABLE, COLUMN and value() for the real backfill: the operator contract
 * (Operator::run) stays as it is.
 */
final class {{ name }} extends Command
{
    public const TABLE = '{{ table }}';

    public const COLUMN = '{{ column }}';

    protected $signature = 'app:{{ slug }} {--apply : Write the changes (without it, a dry run)} {--force : Allow --apply in production, after typing the command name} {--chunk=500 : Rows per batch}';

    protected $description = 'Backfill '.self::TABLE.'.'.self::COLUMN.' (dry run unless --apply)';

    public function handle(): int
    {
        return Operator::run($this, function (OperatorRun $run): void {
            DB::table(self::TABLE)->orderBy('id')->chunkById(max(1, (int) $this->option('chunk')), function ($rows) use ($run): void {
                $run->each($rows, function (object $row, OperatorRun $run): void {
                    if ($row->{self::COLUMN} !== null) {
                        $run->skipped('already done');

                        return;
                    }
                    // The guard repeats in the write, so a row another process filled since the read is left alone.
                    $run->write(fn () => DB::table(self::TABLE)->where('id', $row->id)->whereNull(self::COLUMN)->update([self::COLUMN => $this->value($row)]));
                    $run->changed();
                });
            });
        });
    }

    /** The value a row gets. */
    private function value(object $row): mixed
    {
        return now();
    }
}
