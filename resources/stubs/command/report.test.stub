<?php

// standards-pattern: {{ leaf }}

use {{ namespace }}\Console\Commands\{{ name }};
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Artisan;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;

// The operator contract for app:{{ slug }}: read-only, so it runs anywhere (production included), counts, and writes nothing.
// Self-contained: it makes the table when the app has none (and drops it after), and counts only the rows it inserts.
beforeEach(function () {
    $this->created = ! Schema::hasTable({{ name }}::TABLE);
    if ($this->created) {
        Schema::create({{ name }}::TABLE, function (Blueprint $table): void {
            $table->id();
            $table->timestamp({{ name }}::COLUMN)->nullable();
        });
    }
    $this->ids = array_map(fn ($value): int => (int) DB::table({{ name }}::TABLE)->insertGetId([{{ name }}::COLUMN => $value]), [null, now()]);
});

afterEach(function () {
    $this->created ? Schema::drop({{ name }}::TABLE) : DB::table({{ name }}::TABLE)->whereIn('id', $this->ids)->delete();
});

it('reports without writing, in production too', function () {
    $this->app['env'] = 'production';
    $before = DB::table({{ name }}::TABLE)->whereIn('id', $this->ids)->orderBy('id')->get()->toArray();

    expect(Artisan::call('app:{{ slug }}'))->toBe(0)
        ->and(Artisan::output())->toContain('not set')
        ->and(DB::table({{ name }}::TABLE)->whereIn('id', $this->ids)->orderBy('id')->get()->toArray())->toEqual($before);
});
