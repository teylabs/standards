use Illuminate\Http\RedirectResponse;
use Inertia\Inertia;
use Inertia\Response;
use Tey\Kit\Features\Core\Concerns\Toastable;

final class {{ name }}Controller
{
    use Toastable;

    public function create(): Response
    {
        return Inertia::render('{{ name }}/Form/Page');
    }

    public function store(Save{{ name }}Request $request, Save{{ name }} $save): RedirectResponse
    {
