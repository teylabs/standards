<!-- standards-pattern: {{ leaf }} -->
<script setup lang="ts">
import { Checkbox, Field, Section, SettingsFrame } from '{{ kit_ui }}';
import { router } from '@inertiajs/vue3';

const save = (key: string, value: boolean) => router.patch('/settings/{{ slug }}', { [key]: value }, { preserveScroll: true });
</script>

<template>
    <SettingsFrame title="{{ title }}">
        <Section title="Preferences">
            <Field id="{{ slug }}-updates" label="Email me updates">
                <Checkbox id="{{ slug }}-updates" name="updates" @update:model-value="(value: boolean | undefined) => save('updates', value === true)" />
            </Field>
        </Section>
    </SettingsFrame>
</template>
