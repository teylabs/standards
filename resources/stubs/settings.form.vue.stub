<!-- standards-pattern: {{ leaf }} -->
<script setup lang="ts">
import { Field, FormActions, FormCard, Input, SettingsFrame } from '@kit/ui';
import { useForm } from '@inertiajs/vue3';

const form = useForm({ name: '' });
</script>

<template>
    <SettingsFrame title="{{ title }}">
        <FormCard title="{{ title }}" @submit="form.patch('/settings/{{ slug }}')">
            <Field label="Name" :error="form.errors.name">
                <Input v-model="form.name" name="name" />
            </Field>
            <FormActions :processing="form.processing" />
        </FormCard>
    </SettingsFrame>
</template>
