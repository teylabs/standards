<?php

// standards-pattern: {{ leaf }}

namespace {{ vm_namespace }};

use Tey\Kit\Features\Core\Data\Action;
use Tey\Kit\Features\Core\Data\WorkbenchInspector;
use Tey\Kit\Features\Core\Data\WorkbenchItem;
use Tey\Kit\Features\Core\ViewModels\WorkbenchViewModel;
use Tey\Kit\Features\Workspaces\WorkspaceUrl;

/** The {{ title_lower }} workbench: its items, the inspectors it offers, and the reorder action only for someone who may rearrange it. */
final class {{ name }}WorkbenchViewModel extends WorkbenchViewModel
{
    /** @param array{items: list<array{id: string, label: string, type: string}>, version: int} $read */
    public function __construct(private readonly int $workspace, private readonly array $read, private readonly bool $canReorder) {}

    public function title(): string
    {
        return '{{ titles }}';
    }

    public function workbenchKey(): string
    {
        return '{{ slug }}';
    }

    /** @return list<WorkbenchItem> */
    public function items(): array
    {
        return array_map(fn (array $item): WorkbenchItem => new WorkbenchItem($item['id'], $item['label'], $item['type']), $this->read['items']);
    }

    public function current(): ?string
    {
        return $this->read['items'][0]['id'] ?? null;
    }

    /** @return list<WorkbenchInspector> */
    public function inspectors(): array
    {
        return [new WorkbenchInspector('@document', '{{ titles }}'), new WorkbenchInspector('item', '{{ title }}')];
    }

    public function reorder(): ?Action
    {
        return $this->canReorder ? new Action('Reorder', WorkspaceUrl::to($this->workspace, '{{ slug }}/workbench/order'), 'put', key: 'reorder') : null;
    }

    public function version(): string|int|null
    {
        return $this->read['version'];
    }
}
