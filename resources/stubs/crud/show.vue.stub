<!-- standards-pattern: {{ leaf }} -->
<script setup lang="ts">
import { ButtonGroup, DropdownAction, InertiaAction, Page, Section } from '{{ kit_ui }}';

type Action = { label: string; url: string; method: string; key?: string | null; destructive?: boolean; confirm?: { title: string; description: string; label: string } | null };
// The header's actions by name; null means this viewer may not. InertiaAction and DropdownAction confirm a destructive one first.
defineProps<{ title: string; record: { id: number; name: string; updated_at: string | null }; actions: { edit: Action | null; delete: Action | null } }>();
</script>

<template>
    <Page md :title="title">
        <template #actions>
            <ButtonGroup v-if="actions.edit || actions.delete">
                <InertiaAction :action="actions.edit as never" />
                <template #menu>
                    <DropdownAction :action="actions.delete as never" />
                </template>
            </ButtonGroup>
        </template>
        <Section title="Details">
            <dl class="grid gap-2 text-sm sm:grid-cols-[10rem_1fr]">
                <dt class="text-muted-foreground">Name</dt>
                <dd>{{ record.name }}</dd>
            </dl>
        </Section>
    </Page>
</template>
