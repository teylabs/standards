<?php

// standards-pattern: {{ leaf }}

namespace {{ namespace }}\Http\Controllers;

use {{ namespace }}\Actions\Delete{{ name }};
use {{ namespace }}\Models\{{ name }};
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Tey\Kit\Features\Core\Concerns\Toastable;
use Tey\Kit\Features\Core\Principal;
use Tey\Kit\Features\Core\Tables\TableSelection;
use Tey\Kit\Features\Core\Users;
use Tey\Kit\Features\Workspaces\TenantBoundary;
use Tey\Kit\Features\Workspaces\WorkspaceUrl;

/** The index's bulk action: the selected {{ titles_lower }}, resolved inside this workspace (TableSelection refuses the whole request if any is not there). */
final class {{ name }}SelectionController
{
    use Toastable;

    public function destroy(Request $request, int $workspace, Delete{{ name }} $delete): RedirectResponse
    {
        $user = $request->user();
        abort_unless(Users::is($user), 401);
        $count = app(TenantBoundary::class)->run($workspace, function () use ($request, $workspace, $user, $delete): int {
            $ids = TableSelection::from($request, {{ name }}::query()->where('workspace_id', $workspace))->modelKeys();

            return $delete->handle(new Principal((int) $user->getAuthIdentifier()), $workspace, $ids);
        });

        $this->toast($count === 1 ? '1 {{ title_lower }} deleted.' : $count.' {{ titles_lower }} deleted.');

        return redirect(WorkspaceUrl::to($workspace, '{{ slug }}'));
    }
}
