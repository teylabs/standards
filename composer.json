{
    "name": "tey/standards",
    "description": "Configured, rule-tagged architecture checks for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "illuminate/config": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/support": "^13.0",
        "nikic/php-parser": "^5.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0",
        "symfony/finder": "^7.0 || ^8.0",
        "symfony/process": "^7.0 || ^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Tey\\Standards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FixtureGood\\": "fixtures/Good/src/",
            "FixtureBad\\": "fixtures/Bad/src/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": ["Tey\\Standards\\StandardsServiceProvider"]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
