{
    "name": "tey/standards",
    "description": "Deployment preflight and configured, rule-tagged architecture checks for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "standards",
        "architecture",
        "preflight",
        "pest"
    ],
    "homepage": "https://github.com/teylabs/standards",
    "support": {
        "issues": "https://github.com/teylabs/standards/issues"
    },
    "authors": [
        {
            "name": "Tey Labs"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "illuminate/config": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/process": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "illuminate/database": "^13.0",
        "nikic/php-parser": "^5.0",
        "pestphp/pest": "^4.7 || ^5.0",
        "pestphp/pest-plugin-arch": "^4.0 || ^5.0",
        "symfony/finder": "^7.0 || ^8.0",
        "laravel/mcp": "^1.1"
    },
    "suggest": {
        "laravel/mcp": "Exposes standards:pattern as the pattern_lookup MCP tool through Laravel Boost.",
        "nikic/php-parser": "Required for architecture checks (^5.0); install in the app's require-dev.",
        "pestphp/pest": "Required for architecture checks (^4.7 || ^5.0); install in the app's require-dev.",
        "pestphp/pest-plugin-arch": "Required for architecture checks (^4.0 || ^5.0); install in the app's require-dev.",
        "symfony/finder": "Required for architecture checks (^7.0 || ^8.0); install in the app's require-dev."
    },
    "conflict": {
        "nikic/php-parser": "<5.0 || >=6.0"
    },
    "autoload": {
        "psr-4": {
            "Tey\\Standards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FixtureGood\\": "fixtures/Good/src/",
            "FixtureBad\\": "fixtures/Bad/src/"
        }
    },
    "bin": [
        "bin/standards"
    ],
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "tey-standards": {
            "ci": {
                "enforce": true
            }
        },
        "laravel": {
            "providers": [
                "Tey\\Standards\\StandardsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
